<configuration>
    <!-- 引入 Spring Boot 默认日志配置（日志级别、控制台输出等由 spring.profiles.active 控制） -->
    <springProperty name="APP_NAME" source="spring.application.name" defaultValue="Agentdemo007"/>
    <springProperty name="LOG_DIR" source="logging.file.path" defaultValue="logs"/>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- 生产级 JSON 结构化日志格式：含 traceId / 级别 / 服务名 / 类 / 消息 / 异常 -->
    <appender name="FILE_JSON_PATTERN" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}.log</file>
        <encoder>
            <pattern>
<![CDATA[{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}","level":"%level","service":"${APP_NAME}","traceId":"%X{traceId}","logger":"%logger{36}","message":"%msg","exception":"%replace(%xException){'\n','\\n'}}%n]]>
            </pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE_JSON_PATTERN"/>
    </root>

    <!-- 生产环境降低第三方框架噪音 -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.apache" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
</configuration>
