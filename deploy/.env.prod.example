# ============================================================
# Agentdemo007 生产环境变量（复制为 deploy/.env.prod 后填写真实值）
# 密钥只放本文件（不进仓库）；provider 列表/闸口/评测黄金集/提示词在 Nacos dataId 里
# ============================================================

# ---- Nacos（配置中心：主配置 / agentdemo-gate.json / agentdemo-eval-* / system-prompt-segments）----
NACOS_SERVER_ADDR=host.docker.internal:8848
# 主配置 dataId 名（application.yml import URL 占位符）：prod 用 -prod 后缀与 dev 区分时填；
# 若走「prod 命名空间 + 同名 dataId」的隔离方案则删除此行（读默认 Agentdemo007.yaml）
NACOS_DATA_ID=Agentdemo007-prod.yaml
# 推荐为 prod 单独建命名空间实现 dev/prod 隔离——必须填 namespace ID（Nacos 命名空间详情里的 UUID 形态串），
# 不是显示名！public 的 ID 是空串，留空即 public。填错显示名不报错、只会拉不到配置被 optional: 静默跳过。
NACOS_NAMESPACE=
# 服务器 Nacos 开启鉴权时填写；未开启留空
NACOS_USERNAME=
NACOS_PASSWORD=

# ---- MySQL（复用 demo-mysql，宿主端口 3379；表已建好，应用账号只需读写 agentdemo007 库）----
DS_URL=jdbc:mysql://host.docker.internal:3379/agentdemo007?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8
DS_USERNAME=agentdemo
DS_PASSWORD=__CHANGE_ME__
DS_DRIVER=com.mysql.cj.jdbc.Driver
# 表已由 DBA 建好；启动时 schema.sql 全 IF NOT EXISTS 空跑无害
JPA_DDL=none

# ---- Redis（复用 redis:7-alpine，6379；无密码留空）----
REDIS_ENABLED=true
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---- RabbitMQ（复用 rabbitmq，5672；guest 禁止远程登录，需 rabbitmqctl 建应用账号）----
RABBITMQ_ENABLED=true
RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=agentdemo
RABBITMQ_PASSWORD=__CHANGE_ME__

# ---- LLM（主备 provider 列表在 Nacos dataId Agentdemo007.yaml；此处密钥解析其 ${SF_KEY}/${ALIYUN_KEY} 占位）----
LLM_ENABLED=true
LLM_TIMEOUT=20s
LLM_THINKING_ENABLED=false
SF_KEY=__CHANGE_ME__
ALIYUN_KEY=__CHANGE_ME__

# ---- RAG 真库（复用 demo-chroma，宿主端口 8001；语料已入库）----
EMBEDDING_ENABLED=true
RERANKER_ENABLED=true
VECTORSTORE_TYPE=chroma
CHROMA_BASE_URL=http://host.docker.internal:8001
CHROMA_COLLECTION=kb_customer_service
# Chroma 未开 Bearer 鉴权则留空
CHROMA_TOKEN=
LUCENE_INDEX_DIR=/opt/agentdemo/data/lucene-bm25
# 注意：RAG 漏斗旋钮（min-score 等）放 Nacos dataId 的 app.rag.* 段做热更新调参——
# 不要在这里设同名 env（env 优先级高于 dataId，设了会把 dataId 调参永久压死）。

# ---- 管理台/评测鉴权（强随机值，勿用 dev 默认 dev-admin-token/dev-eval-token）----
ADMIN_TOKEN=__CHANGE_ME__
EVAL_TOKEN=__CHANGE_ME__

# ---- 访问闸口（发布口径以 Nacos agentdemo-gate.json 热更新为准；以下为 Nacos 不可达时的兜底值）----
GATE_ENABLED=true
GATE_ACCESS_CODE=__CHANGE_ME__
GATE_DAILY_LIMIT=5
GATE_SOURCE=nacos
